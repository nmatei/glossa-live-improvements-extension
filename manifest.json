{
  "name": "Glossa.live projector cast",
  "version": "1.3.0",
  "description": "Present Glossa.live on a projector or TV screen — cast-optimised UI improvements for presenters 📽️",
  "manifest_version": 3,
  "author": "Matei Nicolae",
  "background": {
    "service_worker": "views/background.js"
  },
  "action": {
    "default_popup": "views/popup/popup.html",
    "default_title": "Glossa.live Controls"
  },
  "permissions": ["activeTab", "storage", "clipboardWrite", "tabs", "scripting"],
  "host_permissions": ["https://glossa.live/*"],
  "content_scripts": [
    {
      "matches": ["https://glossa.live/*"],
      "js": ["views/icons/icons.js", "views/common/utilities.js", "views/common/tooltip/tooltip.js", "views/common/simplePrompt/simplePrompt.js"],
      "css": [
        "views/common/colors.css",
        "views/common/tooltip/tooltip.css",
        "views/common/simplePrompt/simplePrompt.css",
        "views/common/actions.css",
        "views/common/CustomScrollChrome.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["https://glossa.live/*"],
      "js": ["views/glossa/index.js"],
      "css": ["views/glossa/overrides.css"]
    }
  ],
  "icons": {
    "16": "views/icons/icon-16.png",
    "48": "views/icons/icon-48.png",
    "128": "views/icons/icon-128.png"
  }
}
